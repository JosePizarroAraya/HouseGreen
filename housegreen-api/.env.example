# Copiar como .env y completar (el .env NO se sube al repositorio)

# Base de datos en Neon: copiar la "connection string" desde la consola de Neon
DATABASE_URL=postgresql://USUARIO:CLAVE@ep-xxxxxx.neon.tech/neondb?sslmode=require
SECRET_KEY=una-clave-larga-y-secreta

# Fotos en Cloudinary: Settings -> API Keys
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret